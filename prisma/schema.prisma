generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Access level for an authenticated user; ADMIN unlocks the CMS/admin dashboard.
enum UserRole {
  CUSTOMER
  ADMIN
}

/// Lifecycle of an order: PENDING -> PAID/CONFIRMED -> PROCESSING -> SHIPPED -> DELIVERED,
/// with CANCELLED as a terminal state reachable from any earlier step.
enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

/// An authenticated shopper or admin; also the NextAuth Adapter's user record.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          UserRole  @default(CUSTOMER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  orders   Order[]
}

/// NextAuth Adapter model: one linked external identity (e.g. OAuth provider) per User.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// NextAuth Adapter model: an active login session token for a User.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// NextAuth Adapter model: single-use token for email/magic-link verification flows.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Which payment gateway fulfilled (or is expected to fulfill) an Order.
enum PaymentProvider {
  RAZORPAY
  PHONEPE
}

/// A customer purchase. Both Razorpay and PhonePe identifier fields exist side by side
/// because either gateway can fulfill an order; only the fields for the active
/// paymentProvider are populated, which is why razorpayOrderId and
/// phonePeMerchantOrderId are both nullable+unique rather than required.
model Order {
  id                     String           @id @default(cuid())
  userId                 String
  totalAmount            Decimal          @db.Decimal(10, 2)
  discountAmount         Decimal          @default(0) @db.Decimal(10, 2)
  promoCode              String?
  status                 OrderStatus      @default(PENDING)
  paymentProvider        PaymentProvider?
  razorpayOrderId        String?          @unique
  razorpayPaymentId      String?
  phonePeMerchantOrderId String?          @unique
  phonePeTransactionId   String?
  createdAt              DateTime         @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([userId])
  @@index([createdAt])
}

/// A single artwork/size line within an Order; price is snapshotted at purchase time
/// so later catalog price changes don't retroactively alter past orders.
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  artworkId String
  size      String
  price     Decimal @db.Decimal(10, 2)
  quantity  Int     @default(1)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// Simple key-value counter store, e.g. a "visitors" key tracking total site visits.
model SiteMetric {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Generic JSON-keyed CMS storage; key is one of "artworks" / "config" / "profile",
/// letting the admin CMS persist differently-shaped content blobs without new tables.
model SiteContent {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

/// Contact, signature, trade, and portfolio-download form submissions (backup when email fails).
model FormEnquiry {
  id        String   @id @default(cuid())
  kind      String
  payload   Json
  emailSent Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}
